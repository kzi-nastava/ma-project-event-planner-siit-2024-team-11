<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialog_valid_ok"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="3dp">

    <!-- event card container -->
    <LinearLayout
        android:id="@+id/card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:background="@drawable/dialog_error_ok_background"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:paddingTop="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- left side of card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/left_side"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="11dp"
            android:paddingEnd="7dp">

            <!-- event name container -->
            <LinearLayout
                android:id="@+id/event_name_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="31dp"
                        android:layout_marginLeft="13dp"
                        android:layout_weight="1"
                        android:background="@drawable/event_card_name_container_background"
                        android:fontFamily="@font/albert_sans"
                        android:maxLines="1"
                        android:paddingBottom="3dp"
                        android:text="Title"
                        android:textFontWeight="800"
                        android:textSize="17sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/close_button"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/icon_remove"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- description container -->
        <LinearLayout
            android:id="@+id/description_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="13dp"
            android:layout_marginTop="9dp"
            android:layout_marginRight="13dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/albert_sans"
                android:text="From:"
                android:textColor="@color/home_event_card_label"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/from_email"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/albert_sans"
                android:maxLines="5"
                android:layout_marginTop="3dp"
                android:text="Your message lorem ipsum lorem ipsum lorem ipsum lorem ipsum lorem ipsum lorem ipsum"
                android:textColor="@color/home_event_card_text"
                android:textSize="15.5sp" />

            <TextView
                android:layout_marginTop="13dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/albert_sans"
                android:text="For:"
                android:textColor="@color/home_event_card_label"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/for_email"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/albert_sans"
                android:maxLines="5"
                android:layout_marginTop="3dp"
                android:text="Your message lorem ipsum lorem ipsum lorem ipsum lorem ipsum lorem ipsum lorem ipsum"
                android:textColor="@color/home_event_card_text"
                android:textSize="15.5sp" />

            <TextView
                android:layout_marginTop="13dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/albert_sans"
                android:text="Grade:"
                android:textColor="@color/home_event_card_label"
                android:textSize="13.5sp" />

            <LinearLayout
                android:id="@+id/stars_container"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:elevation="2dp"
                android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/star1"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/icon_star_gold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/star2"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/icon_star_grey" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/star3"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/icon_star_grey" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/star4"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/icon_star_grey" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/star5"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:background="@drawable/icon_star_grey" />
        </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

