<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".solutions.SolutionDetailsFragment">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        >
        <!-- Title -->
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Name"
            android:textSize="50sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/albert_sans"/>

        <ImageButton
            android:id="@+id/favorite_button"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="15dp"
            android:layout_gravity="center"
            android:background="@drawable/icon_favorite_smaller" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/edit_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:backgroundTint="@color/dark_blue_button"
                android:visibility="gone"
                android:text="Edit"
                android:layout_weight="1"
                android:layout_marginRight="10dp"
                android:layout_marginLeft="5dp"
                android:fontFamily="@font/albert_sans"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/delete_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:backgroundTint="@color/red_255_button"
                android:text="Delete"
                android:layout_weight="1"
                android:layout_marginRight="10dp"
                android:layout_marginLeft="5dp"
                android:fontFamily="@font/albert_sans"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="5dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/toggle_visibility_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:backgroundTint="@color/green_button"
                android:text="Visibility"
                android:layout_weight="1"
                android:layout_marginRight="10dp"
                android:layout_marginLeft="5dp"
                android:fontFamily="@font/albert_sans"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toggle_availability_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:backgroundTint="@color/green_button"
                android:visibility="gone"
                android:text="Availability"
                android:layout_weight="1"
                android:layout_marginRight="10dp"
                android:layout_marginLeft="5dp"
                android:fontFamily="@font/albert_sans"/>
        </LinearLayout>

        <!-- Image -->
        <ImageView
            android:id="@+id/image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:layout_gravity="center"/>

        <TextView
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textSize="30sp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:fontFamily="@font/albert_sans"/>

        <TextView
            android:id="@+id/specifics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Specifics"
            android:textSize="30sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:gravity="center"
            android:fontFamily="@font/albert_sans"/>

        <TextView
            android:id="@+id/event_types"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Suitable event types"
            android:textSize="30sp"
            android:gravity="center"
            android:fontFamily="@font/albert_sans"/>

        <TextView
            android:id="@+id/service_length"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Service length"
            android:textSize="30sp"
            android:visibility="gone"
            android:gravity="center"
            android:fontFamily="@font/albert_sans"/>

        <TextView
            android:id="@+id/deadlines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deadlines"
            android:textSize="30sp"
            android:visibility="gone"
            android:gravity="center"
            android:fontFamily="@font/albert_sans"/>

        <TextView
            android:id="@+id/acceptance_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Acceptance type"
            android:textSize="30sp"
            android:visibility="gone"
            android:gravity="center"
            android:fontFamily="@font/albert_sans"/>

        <!-- price container -->
        <LinearLayout
            android:id="@+id/price_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:elevation="2dp"
            android:orientation="vertical"
            android:gravity="center">

            <!-- price before discount container -->
            <FrameLayout
                android:id="@+id/discount_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="16dp">

                    <LinearLayout
                        android:id="@+id/price_before_container"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginTop="1.5dp"
                        android:layout_marginEnd="5dp"
                        android:orientation="horizontal">

                        <!-- price before discount -->
                        <TextView
                            android:id="@+id/before_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/albert_sans"
                            android:maxLines="1"
                            android:paddingStart="2dp"
                            android:textFontWeight="900"
                            android:text="@string/solution_price_before_discount"
                            android:textColor="@color/home_solution_card_before_price"
                            android:textSize="12sp" />

                        <!-- euro symbol -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="1dp"
                            android:fontFamily="@font/albert_sans"
                            android:maxLines="1"
                            android:textFontWeight="900"
                            android:text="@string/euro_symbol"
                            android:textColor="@color/home_solution_card_before_price"
                            android:textSize="9sp"
                            tools:ignore="SmallSp" />
                    </LinearLayout>

                    <!-- crossed out price before discount container -->
                    <LinearLayout
                        android:id="@+id/crossed_out_container"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginTop="1.5dp"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/solution_card_price_crossed_out"
                        android:orientation="horizontal">

                        <!-- crossed out price before discount -->
                        <TextView
                            android:id="@+id/crossed_out_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/albert_sans"
                            android:maxLines="1"
                            android:textFontWeight="900"
                            android:text="@string/solution_price_before_discount"
                            android:textColor="@color/home_solution_card_before_price_crossed_out"
                            android:textSize="12sp" />

                        <!-- crossed out euro symbol -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="1dp"
                            android:fontFamily="@font/albert_sans"
                            android:maxLines="1"
                            android:textFontWeight="900"
                            android:text="@string/euro_symbol"
                            android:textColor="@color/home_solution_card_before_price_crossed_out"
                            android:textSize="9sp"
                            tools:ignore="SmallSp" />
                    </LinearLayout>
                </RelativeLayout>
            </FrameLayout>

            <!-- price after discount container -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <!-- price before discount -->
                <TextView
                    android:id="@+id/current_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/albert_sans"
                    android:maxLines="1"
                    android:text="@string/solution_current_price"
                    android:textColor="@color/home_event_card_text"
                    android:textFontWeight="900"
                    android:textSize="28sp" />

                <!-- euro symbol -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="1dp"
                    android:fontFamily="@font/albert_sans"
                    android:maxLines="1"
                    android:text="@string/euro_symbol"
                    android:textColor="@color/home_event_card_text"
                    android:textFontWeight="900"
                    android:textSize="25sp"
                    tools:ignore="SmallSp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Brought to you by: "
                android:textSize="20sp"/>

            <ImageView
                android:id="@+id/provider_image"
                android:layout_width="40dp"
                android:layout_height="40dp"/>

            <TextView
                android:id="@+id/provider_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Provider name"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textSize="20sp"
                android:background="@drawable/event_card_see_more_border"
                android:layout_marginLeft="10dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:backgroundTint="#D3D3D3"
            android:padding="10dp"
            android:background="@drawable/chat_border">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="20sp"
                android:text="Reviews"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/solution_details_reviews_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chat_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:backgroundTint="@color/dark_blue_button"
                android:text="Chat with provider"
                android:visibility="gone"
                android:layout_weight="1"
                android:layout_marginRight="5dp"
                android:layout_marginLeft="10dp"
                android:fontFamily="@font/albert_sans"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/purchase_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:backgroundTint="@color/green_button"
                android:text="Get solution"
                android:visibility="gone"
                android:layout_weight="1"
                android:layout_marginRight="10dp"
                android:layout_marginLeft="5dp"
                android:fontFamily="@font/albert_sans"/>

        </LinearLayout>
    </LinearLayout>


</ScrollView>