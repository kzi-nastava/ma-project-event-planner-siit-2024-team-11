<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/event_card"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/notification_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- event card container -->
        <LinearLayout
            android:id="@+id/card_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:background="@drawable/event_card_white_background"
            android:elevation="2dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- left side of card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/left_side"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/event_card_blue_stripe_background"
                android:paddingStart="19dp"
                android:paddingTop="9dp"
                android:paddingEnd="10dp"
                android:paddingBottom="11dp">

                <!-- title container -->
                <FrameLayout
                    android:id="@+id/title_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- title -->
                        <TextView
                            android:id="@+id/notification_title"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/albert_sans"
                            android:paddingBottom="3dp"
                            android:text="@string/event_name"
                            android:textFontWeight="800"
                            android:textSize="14.5sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <FrameLayout
                            android:id="@+id/red_dot"
                            android:layout_width="20dp"
                            android:visibility="visible"
                            android:layout_height="match_parent">

                            <FrameLayout
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="2dp"
                                android:layout_marginRight="2dp"
                                android:layout_gravity="end"
                                android:background="@drawable/icon_circle_red">
                            </FrameLayout>

                        </FrameLayout>
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/review_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="visible"
                    android:layout_marginTop="5dp"
                    android:paddingBottom="5dp"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/title_container">

                    <FrameLayout
                        android:id="@+id/grader_picture_container"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/icon_circle_background"
                        android:clipToOutline="true">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/grader_picture"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bon_jovi"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/roundImage"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/grader_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#B7B7B7"
                            android:textSize="12sp"
                            android:layout_marginStart="3dp"
                            android:maxLines="1"
                            android:fontFamily="@font/albert_sans"
                            android:text="\@hdsa has reviewed your event">
                        </TextView>

                        <!-- description container -->
                        <LinearLayout
                            android:id="@+id/stars_container"
                            android:layout_marginTop="2dp"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/star1"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="4dp"
                                android:background="@drawable/icon_star_gold" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/star2"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="4dp"
                                android:background="@drawable/icon_star_grey" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/star3"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="4dp"
                                android:background="@drawable/icon_star_grey" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/star4"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="4dp"
                                android:background="@drawable/icon_star_grey" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/star5"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/icon_star_grey" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- message -->
                <TextView
                    android:id="@+id/notification_message"
                    android:layout_marginTop="2dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/albert_sans"
                    android:maxLines="4"
                    android:text="@string/product_description_text"
                    android:textColor="@color/home_event_card_text"
                    android:textSize="13.5sp"
                    app:layout_constraintTop_toBottomOf="@+id/review_container"
                    tools:layout_editor_absoluteX="19dp" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/date_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="11.02.2024. 12:54h"
        android:layout_marginEnd="6dp"
        android:textSize="13.5sp"
        android:fontFamily="@font/albert_sans"
        android:textColor="#B3B3B3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/notification_card">
    </TextView>

</androidx.constraintlayout.widget.ConstraintLayout>

