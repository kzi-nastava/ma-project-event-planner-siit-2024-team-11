<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/view_holder_budget_item_overview_layout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/chat_border"
        android:weightSum="5"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:id="@+id/view_holder_budget_item_category_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="center"
            android:text="Category"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:text="@string/allocated_funds"/>
            <TextView
                android:id="@+id/view_holder_budget_item_allocated_funds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:text="test"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:text="@string/used_funds"/>
            <TextView
                android:id="@+id/view_holder_budget_item_used_funds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:text="test"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:text="@string/remainder"/>
            <TextView
                android:id="@+id/view_holder_budget_item_remainder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:text="test"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:weightSum="2"
            android:gravity="center"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/view_holder_budget_item_edit_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:backgroundTint="@color/dark_blue_button"
                app:cornerRadius="18dp"
                app:icon="@drawable/icon_edit"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="26dp"
                app:iconTint="@android:color/white"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:strokeColor="@color/black"
                app:strokeWidth="1dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/view_holder_budget_item_delete_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:iconSize="26dp"
                android:backgroundTint="@color/red_255_button"
                app:cornerRadius="18dp"
                app:icon="@drawable/icon_delete"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                android:layout_marginStart="5dp"
                app:iconTint="@android:color/white"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:strokeColor="@color/black"
                app:strokeWidth="1dp"/>
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/view_holder_budget_item_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/view_holder_budget_item_overview_layout"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/view_holder_budget_item_add_solution_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/border_dashed"
        app:layout_constraintStart_toStartOf="parent"
        android:text="+"
        android:layout_marginTop="10dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintTop_toBottomOf="@id/view_holder_budget_item_recycler"
        android:textColor="@color/black"
        android:layout_gravity="center"
        android:elevation="0dp"
        android:padding="0dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>