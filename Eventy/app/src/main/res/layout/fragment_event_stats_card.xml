<?xml version="1.0" encoding="utf-8"?>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".events.eventstats.EventStatsCardFragment">

    <!-- Card Fragment -->
    <FrameLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <!-- First Row: Number Chart & Bar Chart -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <!-- Number Chart -->
        <TextView
            android:id="@+id/numberChart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="117/150"
            android:textSize="24sp"
            android:textStyle="bold"
            android:background="@android:color/darker_gray"
            android:padding="16dp"
            android:textColor="@android:color/white" />

        <!-- Bar Chart -->
        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/barChart"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_weight="1"
            android:background="@android:color/white" />
    </LinearLayout>

    <!-- Second Row: Average Grade Chart -->
    <com.github.mikephil.charting.charts.PieChart
        android:id="@+id/averageGradeChart"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="16dp"
        android:background="@android:color/white" />

    <!-- Download Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDownload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Download"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:icon="@android:drawable/stat_sys_download"
        android:iconGravity="textStart" />

</LinearLayout>