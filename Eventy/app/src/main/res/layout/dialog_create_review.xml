<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialog_error_ok"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="3dp">

    <!-- event card container -->
    <LinearLayout
        android:id="@+id/card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:background="@drawable/dialog_error_ok_background"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingLeft="7dp"
        android:paddingRight="7dp"
        android:paddingTop="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- left side of card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/left_side"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="15dp"
            android:paddingTop="11dp"
            android:paddingEnd="7dp">

            <!-- event name container -->
            <LinearLayout
                android:id="@+id/event_name_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/icon"
                        android:layout_width="29dp"
                        android:layout_height="29dp"
                        android:layout_gravity="center"
                        android:background="@drawable/icon_star_gold" />

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="31dp"
                        android:layout_marginLeft="13dp"
                        android:layout_marginRight="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/event_card_name_container_background"
                        android:fontFamily="@font/albert_sans"
                        android:maxLines="1"
                        android:paddingBottom="3dp"
                        android:text="Title"
                        android:textFontWeight="800"
                        android:textSize="17sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </LinearLayout>

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- description container -->
        <LinearLayout
            android:id="@+id/description_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="13dp"
            android:layout_marginTop="9dp"
            android:layout_marginRight="13dp"
            android:layout_marginBottom="13dp"
            android:elevation="2dp"
            android:orientation="vertical">

            <!-- description text -->
            <TextView
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/albert_sans"
                android:maxLines="5"
                android:text="Your message lorem ipsum lorem ipsum lorem ipsum lorem ipsum lorem ipsum lorem ipsum"
                android:textColor="@color/home_event_card_text"
                android:textSize="15.5sp" />
        </LinearLayout>

        <!-- description container -->
        <LinearLayout
            android:id="@+id/stars_container"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_gravity="center_horizontal"
            android:elevation="2dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/star1"
                android:layout_width="42dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/icon_star_gold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/star2"
                android:layout_width="42dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/icon_star_grey" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/star3"
                android:layout_width="42dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/icon_star_grey" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/star4"
                android:layout_width="42dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/icon_star_grey" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/star5"
                android:layout_width="42dp"
                android:layout_height="40dp"
                android:background="@drawable/icon_star_grey" />
        </LinearLayout>

        <!-- Description Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:elevation="2dp"
            android:id="@+id/review_message_container"
            android:hint="Message"
            android:layout_width="match_parent"
            android:layout_marginRight="15dp"
            android:layout_marginLeft="15dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:background="@drawable/event_card_description_background"
            app:hintTextColor="@color/home_event_card_label"
            app:endIconMode="clear_text"
            android:textColor="@color/home_event_card_text"
            app:boxBackgroundColor="@color/white"
            app:boxStrokeColor="#A0ABC7"
            app:endIconDrawable="@drawable/icon_remove">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/review_message"
                android:inputType="textMultiLine"
                android:minLines="1"
                android:maxLines="3"
                android:gravity="top|start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="@color/home_event_card_text"
                android:background="@drawable/event_card_description_background"/>
            />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/confirm_button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:layout_marginBottom="18dp"
            android:textColor="@color/white"
            android:background="@drawable/filter_button_background"
            android:fontFamily="@font/albert_sans"
            android:letterSpacing="0.05"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:layout_marginRight="15dp"
            android:layout_marginLeft="15dp"
            android:text="CONFIRM"
            android:textAllCaps="false"
            android:textFontWeight="900"
            android:textSize="17sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

