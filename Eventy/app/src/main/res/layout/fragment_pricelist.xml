<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rel_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/pricelist_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pricelist"
            android:textSize="20sp"
            android:fontFamily="@font/albert_sans"
            android:textStyle="bold"/>

        <ImageButton
            android:id="@+id/pricelist_download_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/icon_download"
            android:backgroundTint="@color/dark_blue_button"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header_row"
        android:layout_above="@id/pagination_container">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pricelist_items_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="5dp"/>
    </ScrollView>


    <LinearLayout
        android:background="@color/background_color"
        android:elevation="15dp"
        android:id="@+id/pagination_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true">

        <Button
            android:id="@+id/btn_previous"
            android:layout_width="37dp"
            android:layout_height="33dp"
            android:layout_marginStart="22dp"
            android:background="@drawable/pagination_previous" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:fontFamily="@font/albert_sans"
            android:text="Items:"
            android:maxLines="1"
            android:textSize="14.5sp" />

        <Spinner
            android:id="@+id/spinner_page_size"
            android:layout_width="0dp"
            android:layout_weight="1.2"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="7dp"
            android:layout_height="wrap_content"
            android:entries="@array/page_size_options"/>

        <TextView
            android:id="@+id/tv_page_info"
            android:layout_width="0dp"
            android:layout_weight="1.2"
            android:textColor="#ABABAB"
            android:textSize="13sp"
            android:maxLines="1"
            android:fontFamily="@font/albert_sans"
            android:layout_marginRight="15dp"
            android:layout_height="wrap_content"
            android:text="Page 1 of 10" />

        <Button
            android:id="@+id/btn_next"
            android:layout_width="37dp"
            android:layout_height="33dp"
            android:layout_marginEnd="22dp"
            android:background="@drawable/pagination_next" />
    </LinearLayout>

</RelativeLayout>