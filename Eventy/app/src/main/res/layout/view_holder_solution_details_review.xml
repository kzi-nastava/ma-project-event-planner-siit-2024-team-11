<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/chat_border"
    android:layout_marginTop="10dp"
    android:padding="10dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/view_holder_review_provider_image"
            android:layout_width="40dp"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/view_holder_review_provider_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sender name"
            android:textSize="15sp"
            android:layout_marginLeft="10dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/view_holder_review_comment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="lorem ipsum ipus pormekmdsskjdfndfj"/>

</LinearLayout>